{
  "name": "classroom-portal",
  "version": "1.0.0",
  "description": "Hệ thống quản lý bài tập và chấm điểm lớp học trực tuyến",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron desktop-main.js",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "dist:mac-universal": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --universal",
    "push": "git add . && git commit -m 'Cap nhat code tu Mac' && git push origin main",
    "push-all": "git update-index --no-skip-worktree data.json && git add . && git commit -m 'Dong bo code va CSDL len GitHub' && git push origin main && git update-index --skip-worktree data.json",
    "pull": "git pull origin main",
    "sync-mac": "node sync-to-mac.js",
    "cleanup-expired": "node cleanup-cloudinary-expired.js",
    "open-mac": "open ~/Downloads/EduClass_BaiTap"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "adm-zip": "^0.6.1",
    "cloudinary": "^2.11.0",
    "express": "^4.19.2",
    "mongodb": "^7.8.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.educlass.portal",
    "productName": "EduClass",
    "copyright": "Copyright © 2026 Thầy Nguyễn Công Danh",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "extraMetadata": {
      "main": "desktop-main.js"
    },
    "files": [
      "desktop-main.js",
      "server.js",
      "cleanup-cloudinary-expired.js",
      "sync-to-mac.js",
      "public/**/*",
      "data.json",
      "data.backup.json",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Cài đặt EduClass Portal",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 200
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
